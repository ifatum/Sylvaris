#!/usr/bin/env bash
set -euo pipefail

dir="${SYLVARIS_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/sylvaris}"
if [ -z "${SYLVARIS_DIR:-}" ] && [ ! -d "$dir" ]; then
    here="$(dirname "$(readlink -f "$0")")"
    for d in "$here/../share/sylvaris" "$here/../shell"; do
        [ -f "$d/shell.qml" ] && dir="$(cd "$d" && pwd)" && break
    done
fi
sock="${XDG_RUNTIME_DIR:-/tmp}/sylvaris/ipc.sock"

usage() {
    cat <<'EOF'
Usage: sylvaris [command]

  (no command)                 start the shell
  greet                        start the SylGreet login screen (for greetd)
  <part> [action] [args...]    run an action; `sylvaris list` shows them all
  center [toggle|open|close]   control SylCenter
  center view <name>           open SylCenter on a view
  theme [toggle|open|close|next|prev|apply|cycle|set <id>|list]
  state [topic]                print the shell state as JSON
  get <key>                    print a setting
  set <key> <value>            change a setting (JSON or plain text)
  settings [open <section>]    open SylSettings
  pick [prompt]                choose one of the lines on stdin in SylPad, like dmenu
  config                       print where the configuration lives
  reload                       reload the shell
  list                         print every part and its actions
  watch [topic...]             stream state changes as JSON lines
EOF
}

json() {
    local out="" w
    for w in "$@"; do
        w="${w//\\/\\\\}"
        w="${w//\"/\\\"}"
        out+="${out:+,}\"$w\""
    done
    printf '[%s]' "$out"
}

run() {
    local reply="" sep=$'\x1f' req
    req="$(printf "%s$sep" "$@")"
    if [ -S "$sock" ] && command -v socat >/dev/null 2>&1; then
        reply="$(printf '%s\n' "$req" | socat -t 5 - "UNIX-CONNECT:$sock" 2>/dev/null)" || reply=""
    fi
    if [ -z "$reply" ]; then
        reply="$(qs -p "$dir" ipc call sylvaris run "$req")"
    fi
    printf '%s\n' "$reply"
    case "$reply" in
    error:*) exit 1 ;;
    esac
}

case "${1:-}" in
"")
    exec qs -p "$dir" -n
    ;;
-h | --help | help)
    usage
    ;;
greet)
    exec qs -p "$dir/greet.qml" -n
    ;;
view)
    run center view "${@:2}"
    ;;
pick)
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    cat >"$tmp/in"
    mkfifo "$tmp/out"
    run pad pick "$tmp/in" "$tmp/out" "${@:2}" >/dev/null
    choice="$(cat "$tmp/out")"
    [ -n "$choice" ] || exit 1
    printf '%s\n' "$choice"
    ;;
reload)
    run shell reload
    ;;
config)
    run shell config
    ;;
state)
    if [ -n "${2:-}" ]; then run state get "$2"; else run state; fi
    ;;
get)
    run settings get "${@:2}"
    ;;
set)
    run settings set "${@:2}"
    ;;
watch)
    { json watch "${@:2}"; echo; } | socat -,ignoreeof "UNIX-CONNECT:$sock"
    ;;
*)
    run "$@"
    ;;
esac
