sleep 1.5
bg timeout 90 python3 "$PWD/tests/fake_openrgb.py" 16742 "$OUT/openrgb.log" > "$OUT/fake.log" 2>&1 & echo $! > "$OUT/fake.pid"; wait
sleep 0.8
syl set rgb.port 16742
syl plugins enable rgb
sleep 2.5
check sylvaris rgb list | grep -q 'Krux Atax Pro RGB (keyboard): Direct, Static, Spectrum Cycle, Off'
check ! grep -q '"op": "leds"' "$OUT/openrgb.log"
syl rgb open
sleep 1.5
shot rgb
syl rgb color ff8800
wait grep -q '"dev": "Krux Atax Pro RGB", "mode": "Static", "colors": \["#ff8800"\]' "$OUT/openrgb.log"
check grep -q '"dev": "Gigabyte RGB", "mode": "Static", "colors": \["#ff8800"\]' "$OUT/openrgb.log"
syl rgb brightness 50
wait grep -q '"dev": "SteelSeries Rival 3 Wireless", "mode": "Static", "colors": \["#804400"\]' "$OUT/openrgb.log"
check sylvaris rgb mode "Spectrum Cycle" "Krux Atax Pro RGB"
wait grep -q '"dev": "Krux Atax Pro RGB", "mode": "Spectrum Cycle"' "$OUT/openrgb.log"
check sylvaris rgb | grep -q '"own":{"off":false,"color":"","mode":"Spectrum Cycle","press":""}'
syl rgb off
wait grep -q '"dev": "Gigabyte RGB", "mode": "Static", "colors": \["#000000"\]' "$OUT/openrgb.log"
check grep -q '"dev": "SteelSeries Rival 3 Wireless", "mode": "Off"' "$OUT/openrgb.log"
syl rgb on
syl rgb follow on
wait grep -q '"colors": \["#803d0d"\]' "$OUT/openrgb.log"
check : > "$OUT/openrgb.log"
check kill -USR1 $(pgrep -P $(cat "$OUT/fake.pid"))
sleep 0.6
check kill -USR1 $(pgrep -P $(cat "$OUT/fake.pid"))
wait grep -q '"dev": "Gigabyte RGB", "mode": "Static", "colors": \["#803d0d"\]' "$OUT/openrgb.log"
check sylvaris rgb press ffffff
check sylvaris rgb | grep -q '"press":"#ffffff"'
syl rgb color nope
check sylvaris rgb color nope 2>&1 | grep -q 'give a colour'
syl center open
sleep 1
syl rgb close
syl set center.extra ["rgb"]
sleep 1.2
shot rgb-center
check sylvaris rgb | grep -q '"on":true'
syl center close
syl settings open rgb
sleep 2
shot rgb-settings
check kill $(cat "$OUT/fake.pid")
